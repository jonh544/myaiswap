# Local development environment for Real-Time AI Virtual Identity Studio
# Copy your real values here, never commit secrets.

# Frontend app configuration
VITE_APP_NAME="Real-Time AI Virtual Identity Studio"
VITE_ENVIRONMENT="development"
VITE_USE_LOCAL_MEDIA_ONLY="true"

# NamiFusion integration (required when enabling live face-swap / voice conversion)
VITE_NAMIFUSION_API_KEY=""
VITE_NAMIFUSION_BASE_URL="https://api.namifusion.example.com"
VITE_ENABLE_LIVE_FACE_SWAP="false"
VITE_ENABLE_LIVE_VOICE_CONVERSION="false"
VITE_ENABLE_VIRTUAL_CAMERA="false"

# Optional backend/runtime values if you wire the provider into Tauri/Rust later
NAMI_FUSION_API_KEY=""
NAMI_FUSION_BASE_URL="https://api.namifusion.example.com"
NAMI_FUSION_TIMEOUT_MS="30000"
